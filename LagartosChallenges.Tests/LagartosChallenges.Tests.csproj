<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pure, Unity-free rules are compiled straight into the tests. -->
    <Compile Include="../LagartosChallenges/HandRules.cs" Link="HandRules.cs" />
    <Compile Include="../LagartosChallenges/DoubleBloodGrant.cs" Link="DoubleBloodGrant.cs" />
    <Compile Include="../LagartosChallenges/AnnoyingRules.cs" Link="AnnoyingRules.cs" />
    <Compile Include="../LagartosChallenges/PeltDecks.cs" Link="PeltDecks.cs" />
    <Compile Include="../LagartosChallenges/Translations.cs" Link="Translations.cs" />
  </ItemGroup>

</Project>
