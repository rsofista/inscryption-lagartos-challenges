<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Inscryption runs on Unity Mono; BepInEx 5 plugins target netstandard2.0. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>LagartosChallenges</AssemblyName>
    <RootNamespace>LagartosChallenges</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- Override on the command line if the game lives elsewhere: -p:GameDir="D:\...\Inscryption" -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Inscryption</GameDir>
    <ManagedDir>$(GameDir)\Inscryption_Data\Managed</ManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Game assemblies (compile-only, never copied). -->
    <Reference Include="Assembly-CSharp" HintPath="$(ManagedDir)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(ManagedDir)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ManagedDir)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="Sirenix.Serialization" HintPath="$(ManagedDir)\Sirenix.Serialization.dll" Private="false" />

    <!-- Mod loader + API (compile-only; installed in-game by r2modman). -->
    <Reference Include="BepInEx" HintPath="..\lib\BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="..\lib\0Harmony.dll" Private="false" />
    <Reference Include="InscryptionAPI" HintPath="..\lib\InscryptionAPI.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\*.png" />
  </ItemGroup>

</Project>
